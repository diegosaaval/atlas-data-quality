# Copy to .env and adjust. All variables are optional.
ATLAS_SEED=7
ATLAS_TICK_SECONDS=1.5
ATLAS_DEFAULT_ROLE=engineer
ATLAS_GITHUB_URL=https://github.com/<your-user>/atlas-one
# Enables the Claude backend for the incident copilot (falls back to rules without it).
ANTHROPIC_API_KEY=
ATLAS_COPILOT_MODEL=claude-opus-5-5
