# Copia a .env y ajusta. Todas las variables son opcionales.
ATLAS_SEED=7
# Segundos reales por cada 15 minutos simulados.
ATLAS_TICK_SECONDS=1.0
# 1 = de vez en cuando aparecen anomalías aleatorias en las cargas (modo en vivo).
ATLAS_RANDOM_ANOMALIES=1
ATLAS_RULES_PATH=data/reglas.json
ATLAS_GITHUB_URL=https://github.com/<tu-usuario>/atlas-one
# Activa Claude para redactar los correos de escalamiento (sin ella se usan plantillas).
ANTHROPIC_API_KEY=
ATLAS_COPILOT_MODEL=claude-opus-5-5
